# ===========================================================
#  ЧЕРНОВИК — прототип
#  Пролог + Глава 1
#  Ren'Py 8.5.3 / Python 3
# ===========================================================

define zh = Character("Женя", color="#cfd6e6")
define ri = Character("Рина", color="#e6b3c8")

default persistent.draft = 1

# --- фоны (заглушки; позже заменим на арт) ---
image bg bedroom  = Solid("#0a0a0f")
image bg kitchen  = Solid("#16130f")
image bg bathroom = Solid("#0f1418")
image bg black    = Solid("#000000")

# --- «спрайты» (заглушки: цветной блок вместо персонажа) ---
image rina idle = Transform(Solid("#2b2030"), xysize=(520, 860))

# --- позиции на экране ---
transform pos_left:
    xalign 0.18
    yalign 1.0

transform pos_right:
    xalign 0.82
    yalign 1.0

# --- экраны мета-слоя ---
screen draft_counter():
    zorder 100
    text "черновик [persistent.draft]" size 22 color "#3f3f52" xalign 0.985 yalign 0.02

screen note(msg):
    zorder 150
    frame:
        xalign 0.03
        yalign 0.06
        background Solid("#1b1620e6")
        padding (26, 18)
        text msg size 26 color "#d9a0b8" italic True


label start:

    $ persistent.draft = 1
    show screen draft_counter

    scene bg bedroom with fade

    "Ночь. Три часа."
    "Батарея щёлкает — раз, другой. Будто кто-то стучит изнутри."
    "Я просыпаюсь не от звука. От света."
    "Экран ноутбука лежит на столе, как лужа."

    show rina idle at pos_right with dissolve
    "Рина сидит на полу, поджав ноги, и печатает. Быстро. Не глядя на клавиши."

    ri "Не спится?"
    zh "Ты светишь мне в лицо."
    ri "Извини."
    "Она не извиняется. Она просто не выключает экран."

    menu:
        "Спросить, что она пишет":
            zh "Что ты пишешь?"
            ri "Нас."
            zh "В смысле?"
            ri "В прямом. Сиди смирно, я как раз до тебя дошла."
        "Сказать, чтобы легла спать":
            zh "Иди спать."
            ri "Сейчас. Ещё строчка."
            "Она говорит это уже сорок минут."
        "Молча смотреть в потолок":
            "Я смотрю в потолок. Там трещина, похожая на реку."
            ri "Ты сейчас опять делаешь вид, что спишь."
            zh "Я не делаю вид."
            ri "Ты всегда так делаешь."

    ri "Жень."
    zh "М?"
    ri "Ты помнишь, как мы познакомились?"

    menu:
        "Конечно. Дождь, козырёк у магазина, ты без зонта":
            zh "Конечно. Дождь. Ты стояла под козырьком у магазина. Без зонта."
            ri "И ты отдал мне свой."
            zh "И потом мёрз всю дорогу домой."
            ri "Ты был такой смешной."
        "Помню. Снег, серое пальто, я опоздал на двадцать минут":
            zh "Помню. Снег. Ты была в сером пальто и злилась, что я опоздал."
            ri "В красном."
            zh "В сером."
            ri "Пусть будет в сером."
            "Она записывает. Я вижу, как двигаются её пальцы."

    "Я хочу сказать что-то ещё, но она уже печатает дальше."
    "Фраза, которую я собирался произнести, появляется на экране раньше меня."
    ri "«Ты всегда так говоришь»."
    zh "Я впервые это говорю."
    ri "Знаю."

    hide rina with dissolve
    "Она закрывает ноутбук. Комната становится чёрной."

    scene bg black with fade
    "ЧЕРНОВИК 1"
    "Глава первая. Правила дома."

    scene bg kitchen with fade

    "Утро пахнет чаем и пылью на батарее."
    show rina idle at pos_right with dissolve
    ri "Доброе. Ты проспал."
    zh "Сколько?"
    ri "Двенадцать."
    zh "Двенадцать чего?"
    ri "Двенадцать часов, Жень."

    "Она ставит передо мной чашку. Вторая — её, с трещиной на ободке."
    zh "Ты не спала."
    ri "Я почти не спала."
    zh "Это разные вещи?"
    ri "Абсолютно."

    ri "Правило номер один."
    zh "У нас есть правила?"
    ri "Одно. Мы не выходим по одному."
    zh "Мы вообще не выходим."
    ri "Вот видишь. Работает."

    "Звонок в дверь. Короткий, вежливый."
    "Мы смотрим друг на друга."
    ri "Ты ждёшь кого-то?"
    zh "Нет."

    menu:
        "Открыть":
            "Я подхожу к двери. В глазок — лестничная клетка, лампа, ничего."
            "За дверью тихо. Слишком тихо для подъезда, где всегда кто-то хлопает."
            "Я открываю."
            "Пусто."
            "На коврике — мокрый след. Один. Будто кто-то стоял и переминался с ноги на ногу."
        "Не открывать":
            "Я не двигаюсь."
            ri "И правильно."
            "Звонок повторяется. Два раза. Потом ещё два."
            "Потом тишина. И в тишине — шаги вниз по лестнице. Медленные. Будто тот, кто уходит, не уверен, что хочет уходить."
        "Спросить, кого она ждёт":
            zh "Ты кого-то ждёшь?"
            ri "Нет."
            "Она отвечает быстро. Быстрее, чем нужно."
            "Звонок смолкает сам."

    show screen note("не так")
    "…"
    hide screen note

    "Вечер. Я чищу зубы и смотрю в зеркало."

    scene bg bathroom with dissolve
    "Оно запотело от душа. На нём что-то написано."
    "Пальцем. Изнутри."
    "Я стираю. Полотенцем. Долго."
    "Остаётся только моё лицо."
    "И мысль: мы живём вдвоём. Изнутри зеркала писать некому."

    scene bg black with fade
    "Конец первой главы."

    show screen note("(дописать)")
    pause 1.5
    hide screen note

    "Конец демо."
    "Спасибо, что прочитал черновик."

    return
